generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  fullName      String   @map("full_name")
  displayName   String?  @map("display_name")
  profileImage  String?  @map("profile_image")
  password      String
  role          UserRole @default(user) // user is for normal access and admin means it has access all data and control globally.
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens  RefreshTokens[]
  oauthProviders OauthProvider[]
  memberAt       OrganisationMembers[]

  @@map("user")
}

model RefreshTokens {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  oldToken  String?
  token     String
  ipAddress String?
  userAgent String?
  userId    String
  deviceId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([token])
  @@unique([deviceId, userId])
  @@index([userId])
  @@map("refresh_tokens")
}

model OauthProvider {
  id         Int     @id @default(autoincrement())
  providerId String? // Usually points to the user id acknowledged by their respective provider
  issuer     String
  userId     String  @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, issuer]) // add error handling in oauth repository
  @@map("oauth_provider")
}

model Address {
  id            Int    @id @default(autoincrement())
  country       String
  streetAddress String @map("street_address")
  state         String
  city          String
  zipCode       String @map("zip_code") // Int codes should be converted to String before hand

  organisation Organisation[]
  client       Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("address")
}

model Organisation {
  id          Int    @id @default(autoincrement())
  name        String
  address     Int
  phoneNumber String @map("phone_Int")
  logoLink    String @map("logo_link")

  organisationMembers OrganisationMembers[]
  organisationRoles   OrganisationRoles[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisationAddress Address @relation(fields: [address], references: [id])

  invoices            Invoice[]
  organisationClients OrganisationClients[]

  @@map("organisation")
}

model OrganisationMembers {
  id             Int    @id @default(autoincrement())
  organisationId Int    @map("organisation_id")
  userId         String @map("user_id")
  roleId         Int    @map("role_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role         OrganisationRoles @relation(fields: [roleId], references: [id])

  @@unique([organisationId, userId])
  @@index([roleId])
  @@index([userId])
  @@map("organisation_members")
}

enum Permissions {
  read
  create
  update
  delete
}

enum Resources {
  all
  invoice
  reports
  // More should be added as app grows
}

model OrganisationRoles {
  id             Int    @id @default(autoincrement())
  organisationId Int    @map("organisation_id")
  roleName       String @map("role_name")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  members    OrganisationMembers[]
  permission MemberPermissions[]

  @@unique(fields: [organisationId, roleName])
  @@index([roleName])
  @@map("organisation_roles")
}

model MemberPermissions {
  id       Int         @id @default(autoincrement())
  roleId   Int         @map("role_id")
  action   Permissions
  resource Resources

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgRole OrganisationRoles @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique(fields: [roleId, action, resource])
  @@map("member_permissions")
}

model Client {
  id      Int    @id @default(autoincrement())
  name    String
  email   String @unique
  address Int

  clientAddress Address @relation(fields: [address], references: [id])

  invoices            Invoice[]
  organisationClients OrganisationClients[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([address])
  @@map("client")
}

model OrganisationClients {
  id             Int @id @default(autoincrement())
  organisationId Int
  clientId       Int

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, clientId])
  @@index([clientId])
  @@map("organisation_clients")
}

enum PaymentStatus {
  paid
  unpaid
  partial
}

model Invoice {
  id             Int           @id @default(autoincrement())
  documentNumber String        @unique @map("document_number")
  organisationId Int           @map("organisation_id")
  clientId       Int           @map("client_id")
  currency       String
  orderedAt      DateTime      @map("ordered_at")
  issuedAt       DateTime      @map("issued_at")
  deliverAt      DateTime      @map("deliver_at")
  dueAt          DateTime      @map("due_at")
  subTotal       Decimal       @map("sub_total")
  discount_rate  Decimal       @map("discount_rate")
  taxRate        Decimal       @map("tax_rate")
  totalDueAmount Decimal       @map("total_due_amount")
  viewedAt       DateTime      @map("viewed_at")
  paidAt         DateTime      @map("paid_at")
  paymentStatus  PaymentStatus @map("payment_status")
  pdfLink        String        @map("pdf_link")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  items           InvoiceItem[]
  billingAddress  InvoiceBillingAddress?
  shippingAddress InvoiceShippingAddress?

  @@index([organisationId])
  @@index([clientId])
  @@map("invoice")
}

model InvoiceItem {
  id               Int     @id @default(autoincrement())
  invoiceId        Int     @map("invoice_id")
  lineItemId       Int     @map("line_item_id")
  qty              Decimal
  totalAmount      Decimal
  ItemDiscountRate Decimal

  lineItem LineItem @relation(fields: [lineItemId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, lineItemId])
  @@index([lineItemId])
  @@map("invoice_item")
}

model LineItem {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String
  unitPrice    Decimal       @map("unit_price")
  invoiceItems InvoiceItem[]

  @@map("line_item")
}

model InvoiceBillingAddress {
  id             Int    @id @default(autoincrement())
  invoiceId      Int    @unique @map("invoice_id")
  country        String
  street_address String
  state          String
  city           String
  zipCode        String @map("zip_code") // Int codes should be converted to String before hand

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_billing_address")
}

model InvoiceShippingAddress {
  id             Int    @id @default(autoincrement())
  invoiceId      Int    @unique @map("invoice_id")
  country        String
  street_address String
  state          String
  city           String
  zipCode        String @map("zip_code") // Int codes should be converted to String before hand

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_shipping_address")
}
