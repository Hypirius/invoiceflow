
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  fullName      String    @map("full_name")
  displayName   String?    @map("display_name")
  profileImage  String?    @map("profile_image")
  password      String
  role          UserRole  @default(user) // user is for normal access and admin means it has access all data and control globally.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshtokens     RefreshTokens[]
  oauthProviders    OauthProvider[]

  @@map("user")
}

model RefreshTokens {
  id        Int   @id @default(autoincrement())
  expiresAt DateTime
  oldToken  String? 
  token     String 
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model OauthProvider {
  id Int @id @default(autoincrement())
  providerId String? // Usually points to the user id acknowledged by their respective provider
  issuer String
  userId String @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, issuer]) // add error handling in oauth repository
  @@map("oauth_provider")
}