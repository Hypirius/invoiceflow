
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id Int @id @default(autoincrement())
  email String @unique 
  full_name String
  display_name String
  profile_image String
  password String
  role Role @default(user)
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt
}